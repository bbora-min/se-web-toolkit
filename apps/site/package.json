{
  "name": "se-site",
  "private": true,
  "version": "0.1.0",
  "description": "SE Web Toolkit 사이트 — 툴킷이 무엇이고 어떻게 쓰는지, 예제 앱 넷과 골격 열 개를 한곳에서. GitHub Pages 의 루트",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": "22.x", "pnpm": "9.x" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "e2e:visual": "playwright test",
    "e2e:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@se/tokens": "workspace:*",
    "@se/ui": "workspace:*",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@se/eslint-plugin": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  }
}
