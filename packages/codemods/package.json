    "typecheck": "node --check bin/se-codemods.mjs && node -e \"import('./src/index.js')\""
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "jscodeshift": "^17.3.0"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bbora-min/se-web-toolkit.git",
    "directory": "packages/codemods"
  },
  "license": "UNLICENSED"
}
